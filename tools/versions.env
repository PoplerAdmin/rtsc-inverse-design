# Pinned versions for install.sh. These are the versions the reference machine ran
# (docs/design/10_ml_capabilities.md; docs/CONTEXT.md). Change them only together with a note in
# docs/INSTALL.md, because every measured cost and calibration in docs/design assumes them.

MICROMAMBA_VERSION=2.0.5-0     # github.com/mamba-org/micromamba-releases (single static binary)
QE_VERSION=7.6                # Quantum ESPRESSO (conda-forge "qe", OpenMPI build)
PYTHON_VERSION=3.12            # rtt main environment
MATTERSIM_VERSION=1.2.5        # pip "mattersim"
MATTERGEN_REPO=https://github.com/microsoft/mattergen.git
MATTERGEN_COMMIT=9242366       # "Fix Linux PyPI installation dependencies (#252)"
MATTERGEN_PYTHON=3.10
UV_VERSION=0.13.6              # builds the MatterGen environment (reference venv: uv 0.13.6)
MATTERGEN_HF_REPO=microsoft/mattergen
# shipped checkpoints used by lanes G1-G5 (src/rtt/campaign/doctor.py LANE_CHECKPOINTS)
MATTERGEN_CHECKPOINTS="mattergen_base chemical_system_energy_above_hull chemical_system space_group dft_band_gap dft_mag_density ml_bulk_modulus"
MATTERSIM_MODEL=MatterSim-v1.0.0-5M.pth
SG15_URL=http://www.quantum-simulation.org/potentials/sg15_oncv/sg15_oncv_upf_2020-02-06.tar.gz
# sha256 of the SG15 tarball (2026-11-01 download; its H and Ir files are byte-identical to the
# reference machine's ~/pseudo/sg15). Empty = do not verify.
SG15_SHA256=3f3bd74aa5d6e0b038218a6051bb99ed9469dc03d0f05b3ec8a523f0f7a7dff0
