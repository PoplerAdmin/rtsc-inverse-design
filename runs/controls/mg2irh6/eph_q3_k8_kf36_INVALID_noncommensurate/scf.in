 &control
    calculation = 'scf'
    prefix = 'pwscf'
    outdir = './tmp/'
    pseudo_dir = '~/pseudo/sg15/'
 /
 &system
    ibrav = 0
    nat = 9
    ntyp = 3
    ecutwfc = 80.0
    ecutrho = 320.0
    occupations = 'smearing'
    smearing = 'mv'
    degauss = 0.02
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.5
 /
